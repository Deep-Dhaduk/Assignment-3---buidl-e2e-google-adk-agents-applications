# Copy to .env. Never commit real credentials.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
# Select a Gemini model available to your account.
ADK_MODEL=gemini-2.5-flash
# For Vertex AI instead: TRUE above, unset GOOGLE_API_KEY, configure ADC.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Local SQLite by default. PostgreSQL / AlloyDB uses the same schema.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/assignment
# ADK_DATA_DIR=./data
# ADK_ARTIFACT_DIR=./artifacts/local

# Gemini CLI is installed locally via npm ci; GOOGLE_API_KEY is forwarded.
CLI_TIMEOUT_SECONDS=120
# GEMINI_CLI_MODEL=gemini-2.5-flash
# Only an explicit opt-in permits execution of trusted sample tests on the host.
REVIEW_EXECUTION=disabled
# REVIEW_EXECUTION=docker requires the assignment-review-runner:local image.

# Authenticated API only; separate from the local ADK development UI.
APP_API_KEY=
